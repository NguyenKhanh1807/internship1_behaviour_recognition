{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fight_demo - sparring (TrackTrack)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fight_demo.py",
      "args": [
        "--source",
        "videos/sparring.mp4",
        "--tracker",
        "tracktrack.yaml",
        "--device",
        "mps",
        "--out",
        "runs/debug_tracktrack"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "TN1 - BoT-SORT ReID + YOLO11n",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fight_demo.py",
