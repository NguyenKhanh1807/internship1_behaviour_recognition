      "name": "TN3 - BoT-SORT ReID + YOLO26n",
      "program": "${workspaceFolder}/fight_demo.py",
      "args": [
        "--source",
        "videos/sparring.mp4",
        "--model",
        "yolo26n-pose.pt",
        "--tracker",
        "my_botsort.yaml",
        "--device",
        "mps",
        "--out",
        "runs/sparring_botsort_reid_y26"
      ]
